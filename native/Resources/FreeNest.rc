#include <windows.h>
#include "resource.h"
#include "FreeNestVersion.h"
plugin pipl "plugin.pipl"
IDD_SETTINGS DIALOGEX 0,0,330,332
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "FreeNest for Illustrator"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "Units",-1,12,11,90,12
 COMBOBOX IDC_UNITS,218,8,100,160,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

 LTEXT "Sheet Material",-1,12,30,84,12
 CONTROL "",-1,"Static",SS_ETCHEDHORZ,100,36,218,1
 CONTROL "Use captured boundary as sheet",IDC_CUSTOM_SHEET,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,44,306,14
 LTEXT "Sheet width (in)",IDC_WIDTH_LABEL,12,65,93,12
 EDITTEXT IDC_WIDTH,105,62,50,14,ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
 LTEXT "Sheet height (in)",IDC_HEIGHT_LABEL,170,65,97,12
 EDITTEXT IDC_HEIGHT,267,62,51,14,ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Contour spacing (in)",IDC_GAP_LABEL,12,83,93,12
 EDITTEXT IDC_GAP,105,80,50,14,ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Sheet edge margin (in)",IDC_MARGIN_LABEL,170,83,97,12
 EDITTEXT IDC_MARGIN,267,80,51,14,ES_AUTOHSCROLL | WS_TABSTOP

 LTEXT "Packing",-1,12,104,48,12
 CONTROL "",-1,"Static",SS_ETCHEDHORZ,64,110,254,1
 LTEXT "Packing style",-1,12,121,145,12
 COMBOBOX IDC_PACKING_STYLE,170,118,148,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Permitted orientations",-1,12,139,145,12
 COMBOBOX IDC_ROTATIONS,170,136,148,95,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Calculation limit (seconds)",-1,12,157,145,12
 EDITTEXT IDC_SECONDS,267,154,51,14,ES_AUTOHSCROLL | WS_TABSTOP

 LTEXT "Layout",-1,12,178,43,12
 CONTROL "",-1,"Static",SS_ETCHEDHORZ,59,184,259,1
 CONTROL "Create additional artboards",IDC_MULTIPLE_SHEETS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,192,194,14
 LTEXT "Maximum",IDC_MAX_SHEETS_LABEL,220,195,45,12
 EDITTEXT IDC_MAX_SHEETS,267,192,51,14,ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
 CONTROL "Include sheet boundary",IDC_INCLUDE_BOUNDARY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,210,155,14
 CONTROL "Center finished layouts",IDC_CENTER_LAYOUTS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,180,210,138,14

 LTEXT "Labels",-1,12,234,40,12
 CONTROL "",-1,"Static",SS_ETCHEDHORZ,56,240,262,1
 CONTROL "Label copies with object names",IDC_ADD_LABELS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,248,215,14
 PUSHBUTTON "Label Options",IDC_LABEL_OPTIONS,235,248,83,15
 CONTROL "Label sheet boundary",IDC_LABEL_BOUNDARY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,266,220,14

 LTEXT "Copies on output artboards. Spacing excludes strokes.",-1,12,288,306,12
 DEFPUSHBUTTON "Nest",IDOK,206,308,53,15
 PUSHBUTTON "Cancel",IDCANCEL,265,308,53,15
END
IDD_LABELS DIALOGEX 0,0,285,214
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "FreeNest - Object Labels"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "Text comes from Illustrator object names.",-1,12,12,240,12
 LTEXT "Maximum label height (in)",IDC_LABEL_HEIGHT_LABEL,12,38,145,12
 EDITTEXT IDC_LABEL_HEIGHT,160,35,85,14,ES_AUTOHSCROLL | WS_TABSTOP | WS_GROUP
 LTEXT "OpenNest VDA font",-1,12,62,145,12
 COMBOBOX IDC_LABEL_FONT,160,59,85,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Label color (RGB)",-1,12,86,145,12
 COMBOBOX IDC_LABEL_COLOR,160,83,110,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Stroke weight (pt)",-1,12,110,145,12
 EDITTEXT IDC_LABEL_WEIGHT,160,107,85,14,ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Label placement",-1,12,134,145,12
 COMBOBOX IDC_LABEL_PLACEMENT,125,131,145,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "Labels shrink to fit. Unnamed or too-small parts are skipped.",-1,12,157,260,25
 DEFPUSHBUTTON "OK",IDOK,154,191,53,15
 PUSHBUTTON "Cancel",IDCANCEL,213,191,53,15
END
IDD_PROGRESS DIALOGEX 0,0,285,128
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "FreeNest - Nesting"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "Calculating a layout...",IDC_STATUS,12,12,260,20
 LTEXT "Elapsed: 0:00",IDC_ELAPSED,12,36,260,12
 LTEXT "Estimated remaining: estimating...",IDC_REMAINING,12,55,260,12
 LTEXT "Estimate uses the calculation limit; may finish earlier. Validation and labels can add time.",IDC_ESTIMATE_NOTE,12,74,260,24
 PUSHBUTTON "Cancel",IDCANCEL,218,105,53,15
END
IDD_ABOUT DIALOGEX 0,0,270,166
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About FreeNest"
FONT 9,"Segoe UI"
BEGIN
 LTEXT "FreeNest for Illustrator",-1,12,10,246,12
 LTEXT FREENEST_ABOUT_VERSION,-1,12,24,246,10
 LTEXT "Nesting and single-stroke labeling for Adobe Illustrator.",-1,12,42,246,20
 LTEXT "Copyright (c) 2026 RJ Duran. MIT license.",-1,12,66,246,10
 LTEXT "Powered by OpenNest by Petras Vestartas and its bundled VDA engraving font.",-1,12,84,246,22
 LTEXT "Windows x64 / Illustrator 2024",-1,12,110,246,10
 LTEXT "Independent project; not affiliated with Adobe.",-1,12,124,246,10
 DEFPUSHBUTTON "Close",IDOK,205,142,53,15
END
1 VERSIONINFO
 FILEVERSION FREENEST_VERSION_NUMBERS
 PRODUCTVERSION FREENEST_VERSION_NUMBERS
 FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904E4"
  BEGIN
   VALUE "FileDescription","FreeNest for Illustrator\0"
   VALUE "FileVersion",FREENEST_VERSION_RESOURCE_STRING
   VALUE "ProductVersion",FREENEST_VERSION_RESOURCE_STRING
   VALUE "ProductName","FreeNest for Illustrator\0"
   VALUE "LegalCopyright","Copyright (c) 2026 RJ Duran\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation",0x0409,1252
 END
END
